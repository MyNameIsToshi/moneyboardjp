@inject LedgerService Svc
@inject IJSRuntime JS
@inject OverlayRegistryService Overlay
@implements IDisposable

@{ var accts = ActiveAccountsForMonth; }
<div>
    <div class="top">
        <div></div>
        <div class="topright">
            <div class="monthnav">
                <button @onclick="Prev" disabled="@IsPrevDisabled"><span class="msym">chevron_left</span></button>
                <div class="m">@LedgerService.Label(Svc.CurrentMonth)</div>
                <button @onclick="Next"><span class="msym">chevron_right</span></button>
            </div>
            <CycleInfo Ym="@Svc.CurrentMonth" />
        </div>
    </div>

    @* サマリ＝ヘッダー帯。月末残高合計をヒーロー化し主役に、不足/口座数/当月支出を従える。 *@
    <div class="summary">
        <div class="stat hero @(Total < 0 ? "neg" : "")">
            <div class="hero-lab">
                月末残高 合計
                @if (Total < 0)
                {
                    <span class="hero-pill"><span class="msym">trending_down</span>赤字</span>
                }
            </div>
            <div class="hero-val">@MaskedYen(IsMasked,Total)</div>
            <div class="hero-sub">@LedgerService.Label(Svc.CurrentMonth) 全口座の見込み合計</div>
        </div>
        <div class="stat @(Short > 0 ? "warn" : "")">
            <div class="lab">不足している口座</div>
            <div class="stat-val-row">
                @if (Short > 0)
                {
                    <span class="warn-chip msym">warning</span>
                }
                <div class="val">@Short 件</div>
            </div>
        </div>
        <div class="stat">
            <div class="lab">口座数</div>
            <div class="val">@Svc.ActiveAccounts.Count</div>
        </div>
        <div class="stat">
            <div class="lab">当月の支出</div>
            <div class="val">@MaskedYen(IsMasked,MonthSpend)</div>
        </div>
    </div>

    <div class="grid">
        @{
            var bonusMonth = Ym.Parse(Svc.CurrentMonth).Month;
            var isCurrentOrFutureMonth = LedgerService.IsCurrentOrFutureCycle(Svc.CurrentMonth);
        }
        @for (int i = 0; i < accts.Count; i++)
        {
            var a = accts[i];
            var l = Mo.Ledgers[a.Id];
            // 財布固有UI（ATM入金の自動受取fold・振替ゾーンの財布モード）専用。それ以外の種別依存分岐は
            // 意味ごとの述語（#164）を使う。
            var isWallet = a.Type == AccountType.Wallet;
            var canReceiveSalary = a.Type.CanReceiveSalary();
            var participatesInAtm = a.Type.ParticipatesInAtm();
            var hasCategorizedSpending = a.Type.HasCategorizedSpending();
            var close = Svc.CloseOf(Svc.CurrentMonth, a.Id);
            var bad = close < 0;
            var outgoing = Mo.Transfers.Where(t => t.From == a.Id).ToList();
            var incoming = Mo.Transfers.Where(t => t.To == a.Id).ToList();
            // 財布は通常の口座間振込ピッカーから除外（財布⇄口座のやり取りはATM入金に一本化・#77）。
            // 財布カード自身にとっては、この一覧がそのままATM入金（財布→口座）の対象口座候補になる。
            var others = accts.Where(x => x.Id != a.Id && x.Type.ParticipatesInAtm()).ToList();
            var isAnchor = Svc.IsOpeningAnchor(Svc.CurrentMonth, a.Id);
            var cardDebits = l.Debits.Where(d => d.CardId != null).ToList();
            var fixedDebits = l.Debits.Where(d => d.CardId == null && d.IsFixed).ToList();
            var manualDebits = l.Debits.Where(d => d.CardId == null && !d.IsFixed).ToList();
            var fixedIncomes = l.Incomes.Where(x => x.IsFixed).ToList();
            var manualIncomes = l.Incomes.Where(x => !x.IsFixed).ToList();
            // ボーナス入力欄の表示可否（#134）：①現受取口座かつボーナス月かつ当月以降（ボーナス月の設定変更が
            // 過去月の表示へ遡って反映されないように＝過去凍結）／②実額記録済み（受取口座変更後の過去凍結分を含む）／
            // ③「＋ボーナスを追加」で手動追加済み。
            var showBonus = canReceiveSalary && BonusSchedule.ShouldShowBonusInput(a.IsBonusAccount, isCurrentOrFutureMonth, Svc.State.BonusMonths, bonusMonth, l.Bonus, _manualBonusShown.Contains(a.Id + "|" + Svc.CurrentMonth));
            // ATM は資産移動のためセクション合計には含めない（既存の統計集計と同じ流儀）。
            var incomeTotal = l.Salary + l.Bonus + l.Incomes.Sum(x => x.Amount);
            var spendTotal = l.Debits.Sum(d => d.Amount);
            var netFlow = incomeTotal - spendTotal;
            // 財布は給料/ボーナスのセクションが無いため、その分をカウントから外す（#77）。
            var incomeCount = (canReceiveSalary ? 1 : 0) + (showBonus ? 1 : 0) + l.Incomes.Count;
            // 収支バーの flex 比（culture 依存のカンマ/小数点区切りが CSS に混ざらないよう invariant で文字列化）。
            var barIn = Math.Max(incomeTotal, 0.01m).ToString(System.Globalization.CultureInfo.InvariantCulture);
            var barOut = Math.Max(spendTotal, 0.01m).ToString(System.Globalization.CultureInfo.InvariantCulture);
            // 口座カードの既定はスマホ=折りたたみ / PC=展開。_toggled は「既定からの反転」。
            var collapsed = _toggled.Contains(a.Id) ? !IsMobile : IsMobile;
            var cardOpen = _cardOpen.Contains(a.Id);
            var fixedOpen = _fixedOpen.Contains(a.Id);
            // ゾーン開閉の既定：収入/支出/振込とも閉。_xxxToggled が展開中の口座を保持。
            var incomeOpen = _incomeToggled.Contains(a.Id);
            var expenseOpen = _expenseToggled.Contains(a.Id);
            var transferOpen = _transferToggled.Contains(a.Id);
            var chip = "c" + (i % 4);

            <div class="acct @(bad ? "bad" : "") @(collapsed ? "collapsed" : "")">
                @* ヘッダーをクリックでカード全体を開閉。畳むと月末残高をヘッダーに出す。 *@
                <button class="ahead" @onclick="() => ToggleAccount(a.Id)">
                    <span class="acct-chip @chip msym">@(isWallet ? "account_balance_wallet" : "account_balance")</span>
                    <span class="aname">@a.Name</span>
                    <span class="badge">@(bad ? "不足" : "OK")</span>
                    @if (collapsed)
                    {
                        <span class="ahead-close">@MaskedYen(IsMasked,close)</span>
                    }
                    <span class="msym ahead-chev">@(collapsed ? "expand_more" : "expand_less")</span>
                </button>

                @if (!collapsed)
                {
                    @* 月初残高は畳んだカードでは表示しないため、展開時のみ計算する（CloseOf 側の内部計算と合わせ二重にはなるが、
                       畳んだ口座・畳んだ月では計算自体を省く）。 *@
                    var opening = Svc.OpeningOf(Svc.CurrentMonth, a.Id);

                    @* ヒーロー：月末残高（見込み）を主役化。収支ピル＋収支バー＋月初/収入/支出の補助行。 *@
                    <div class="acct-hero">
                        <div class="acct-hero-top">
                            <div class="acct-hero-lab">月末残高（見込み）</div>
                            @* マスク時は収支の増減方向（アイコン・色）も伏せる。数値だけでなく符号も個人情報のため。 *@
                            <div class="acct-hero-pill @(IsMasked ? "masked" : (netFlow < 0 ? "bad" : ""))">
                                <span class="msym">@(IsMasked ? "trending_flat" : (netFlow < 0 ? "trending_down" : "trending_up"))</span>@MaskedSignedYen(IsMasked,netFlow)
                            </div>
                        </div>
                        <div class="acct-hero-val @(bad ? "neg" : "")">@MaskedYen(IsMasked,close)</div>
                        @* マスク時は収支バーの塗り分けが比率を漏らさないよう均等表示にする。 *@
                        <div class="acct-hero-bar">
                            <span class="bar-in" style="flex:@(IsMasked ? "1" : barIn)"></span>
                            <span class="bar-out" style="flex:@(IsMasked ? "1" : barOut)"></span>
                        </div>
                        <div class="acct-hero-sub">
                            <span class="@(opening < 0 ? "neg" : "")">月初 @MaskedYen(IsMasked,opening)</span>
                            <span>収入 @MaskedYen(IsMasked,incomeTotal)</span>
                            <span>支出 @MaskedYen(IsMasked,spendTotal)</span>
                        </div>
                    </div>

                    @* 月初残高の手入力は起点月のみ（通常月は上のヒーロー補助行に畳む＝表示専用）。 *@
                    @if (isAnchor)
                    {
                        <div class="opening-box anchor">
                            <div class="opening-lab">
                                <span>月初残高 <span class="opening-badge">起点</span></span>
                                <span class="hint">初月のため手入力</span>
                            </div>
                            <AmountInput CssClass="num opening-input" Value="@l.Confirmed" ValueChanged="v => { l.Confirmed = v; Svc.RequestSave(); }" />
                        </div>
                    }

                    @* 収入ゾーン（緑・既定=閉） *@
                    <div class="zone zone-income">
                        <button class="zone-head" @onclick="() => ToggleIncome(a.Id)">
                            <span class="zone-chip zone-chip-income msym">trending_up</span>
                            <span class="zone-name zone-name-income">収入</span>
                            <span class="zone-count">@incomeCount 件</span>
                            <span class="zone-spacer"></span>
                            <span class="zone-subtotal zone-subtotal-income">@MaskedSignedYen(IsMasked,incomeTotal)</span>
                            <span class="msym zone-chev">@(incomeOpen ? "expand_less" : "expand_more")</span>
                        </button>
                        @if (incomeOpen)
                        {
                            <div class="zone-body">
                                @if (canReceiveSalary)
                                {
                                    <div class="field">
                                        <label>給料</label>
                                        <AmountInput CssClass="num" Value="@l.Salary" ValueChanged="v => { l.Salary = v; Svc.RequestSave(); }" />
                                    </div>
                                }
                                @if (canReceiveSalary)
                                {
                                    @if (showBonus)
                                    {
                                        <div class="field">
                                            <label>ボーナス @if (a.IsBonusAccount) { <span class="bonus-tag">受取口座</span> }</label>
                                            <AmountInput CssClass="num" Value="@l.Bonus" ValueChanged="v => { l.Bonus = v; Svc.RequestSave(); }" />
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="add-line" @onclick="() => AddBonusInput(a.Id)"><span class="msym">add</span>ボーナスを追加</button>
                                    }
                                }
                                @* ATM入金（資産移動のため統計には含めない）。財布有効時は口座側の手入力を無効化し、
                                   財布からの実体化値（materialize）を表示専用にする（#77）。財布側は各口座からの
                                   内訳を固定費/カードと同様に折りたたみ表示する（#77フォローアップ）。 *@
                                @if (isWallet)
                                {
                                    var atmInSources = accts.Where(x => x.Type.ParticipatesInAtm())
                                        .Select(x => (Account: x, Amount: Mo.Ledgers.TryGetValue(x.Id, out var xl) ? xl.AtmWithdraw : 0m))
                                        .Where(x => x.Amount != 0)
                                        .ToList();
                                    var atmInOpen = _walletAtmInOpen.Contains(a.Id);
                                    <div class="fold @(atmInOpen ? "open" : "")">
                                        <button class="fold-head" @onclick="() => ToggleWalletAtmIn(a.Id)">
                                            <span class="fold-head-lab"><span class="msym">local_atm</span> ATM入金（自動受取） @atmInSources.Count 件</span>
                                            <span class="fold-head-right">
                                                <span class="fold-total">@MaskedYen(IsMasked,l.AtmDeposit)</span>
                                                <span class="msym fold-chev">@(atmInOpen ? "expand_less" : "expand_more")</span>
                                            </span>
                                        </button>
                                        @if (atmInOpen)
                                        {
                                            <div class="fold-list">
                                                @if (atmInSources.Count == 0)
                                                {
                                                    <div class="none">なし</div>
                                                }
                                                @foreach (var src in atmInSources)
                                                {
                                                    <div class="fixed-row">
                                                        <span class="fixed-name">@src.Account.Name</span>
                                                        <span class="fixed-amt">@MaskedYen(IsMasked,src.Amount)</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else if (Svc.HasActiveWallet)
                                {
                                    <div class="row atm-row">
                                        <span class="atm-label"><span class="msym">local_atm</span> ATM入金（財布より）</span>
                                        <span class="atm-auto">@MaskedYen(IsMasked,l.AtmDeposit)</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="row atm-row">
                                        <span class="atm-label"><span class="msym">local_atm</span> ATM入金</span>
                                        <AmountInput CssClass="amt" Value="@l.AtmDeposit" ValueChanged="v => { l.AtmDeposit = v; Svc.RequestSave(); }" />
                                    </div>
                                }
                                @* 収入固定費＝表示専用（折りたたみ）。金額未固定はここで月ごとに金額を編集できる（#95）。 *@
                                @if (fixedIncomes.Count > 0)
                                {
                                    var fixedIncomeOpen = _fixedIncomeOpen.Contains(a.Id);
                                    <div class="fold @(fixedIncomeOpen ? "open" : "")">
                                        <button class="fold-head" @onclick="() => ToggleFixedIncome(a.Id)">
                                            <span class="fold-head-lab"><span class="msym">payments</span> 固定費（収入） @fixedIncomes.Count 件</span>
                                            <span class="fold-head-right">
                                                <span class="fold-total">@MaskedYen(IsMasked,fixedIncomes.Sum(x => x.Amount))</span>
                                                <span class="msym fold-chev">@(fixedIncomeOpen ? "expand_less" : "expand_more")</span>
                                            </span>
                                        </button>
                                        @if (fixedIncomeOpen)
                                        {
                                            <div class="fold-list">
                                                @foreach (var fInc in fixedIncomes)
                                                {
                                                    <div class="fixed-row">
                                                        <span class="fixed-name">@fInc.Name</span>
                                                        @if (fInc.IsVariable)
                                                        {
                                                            <span class="msym fixed-lock" title="金額未固定：この月の金額を編集できます">sync</span>
                                                            <AmountInput CssClass="fixed-amt-input" Value="@fInc.Amount" ValueChanged="v => { fInc.Amount = v; fInc.AmountOverridden = IsCurrentCycleMonth; Svc.RequestSave(); }" />
                                                        }
                                                        else
                                                        {
                                                            <span class="msym fixed-lock" title="収入固定費マスタから展開">lock</span>
                                                            <span class="fixed-amt">@MaskedYen(IsMasked,fInc.Amount)</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @foreach (var inc in manualIncomes)
                                {
                                    <div class="row">
                                        <input class="name" @bind="inc.Name" @bind:after="Save" placeholder="収入名（例：副業・還付金）" />
                                        <AmountInput CssClass="amt" Value="@inc.Amount" ValueChanged="v => { inc.Amount = v; Svc.RequestSave(); }" />
                                        <button class="x" @onclick="() => RemoveIncome(a.Id, inc.Id)">✕</button>
                                    </div>
                                }
                                <button class="add-line" @onclick="() => AddIncome(a.Id)"><span class="msym">add</span>収入を追加</button>
                            </div>
                        }
                    </div>

                    @* 支出ゾーン（赤・既定=閉）。固定費/カードは表示専用サマリ行、手入力のみ input。 *@
                    <div class="zone zone-expense">
                        <button class="zone-head" @onclick="() => ToggleExpense(a.Id)">
                            <span class="zone-chip zone-chip-expense msym">trending_down</span>
                            <span class="zone-name zone-name-expense">支出</span>
                            <span class="zone-count">@(hasCategorizedSpending ? "現金支出" : "固定費・カード他")</span>
                            <span class="zone-spacer"></span>
                            <span class="zone-subtotal zone-subtotal-expense">@MaskedSignedYen(IsMasked,-spendTotal)</span>
                            <span class="msym zone-chev">@(expenseOpen ? "expand_less" : "expand_more")</span>
                        </button>
                        @if (expenseOpen)
                        {
                            <div class="zone-body">
                                @* 固定費＝表示専用（折りたたみ）。金額の変更は固定費設定タブから。財布は非対象（#77）。 *@
                                @if (participatesInAtm && fixedDebits.Count > 0)
                                {
                                    <div class="fold @(fixedOpen ? "open" : "")">
                                        <button class="fold-head" @onclick="() => ToggleFixed(a.Id)">
                                            <span class="fold-head-lab"><span class="msym">lock</span> 固定費（支出） @fixedDebits.Count 件</span>
                                            <span class="fold-head-right">
                                                <span class="fold-total">@MaskedYen(IsMasked,fixedDebits.Sum(d => d.Amount))</span>
                                                <span class="msym fold-chev">@(fixedOpen ? "expand_less" : "expand_more")</span>
                                            </span>
                                        </button>
                                        @if (fixedOpen)
                                        {
                                            <div class="fold-list">
                                                @foreach (var d in fixedDebits)
                                                {
                                                    <div class="fixed-row">
                                                        <span class="fixed-name">@d.Name</span>
                                                        @if (d.IsVariable)
                                                        {
                                                            <span class="msym fixed-lock" title="変動費：この月の金額を編集できます">sync</span>
                                                            <AmountInput CssClass="fixed-amt-input" Value="@d.Amount" ValueChanged="v => { d.Amount = v; d.AmountOverridden = IsCurrentCycleMonth; Svc.RequestSave(); }" />
                                                        }
                                                        else
                                                        {
                                                            <span class="msym fixed-lock" title="固定費マスタから展開">lock</span>
                                                            <span class="fixed-amt">@MaskedYen(IsMasked,d.Amount)</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @* カード由来＝表示専用（折りたたみ）。展開で各カードへのリンク行。財布は非対象（#77）。 *@
                                @if (participatesInAtm && cardDebits.Count > 0)
                                {
                                    <div class="fold @(cardOpen ? "open" : "")">
                                        <button class="fold-head" @onclick="() => ToggleCardBlock(a.Id)">
                                            <span class="fold-head-lab"><span class="msym">credit_card</span> カード @cardDebits.Count 件</span>
                                            <span class="fold-head-right">
                                                <span class="fold-total">@MaskedYen(IsMasked,cardDebits.Sum(d => d.Amount))</span>
                                                <span class="msym fold-chev">@(cardOpen ? "expand_less" : "expand_more")</span>
                                            </span>
                                        </button>
                                        @if (cardOpen)
                                        {
                                            <div class="fold-list">
                                                @foreach (var d in cardDebits)
                                                {
                                                    <div class="row card-row" @onclick="() => GoToCard(d.CardId)" title="カードタブで明細を編集">
                                                        <span class="name card-name"><span class="msym">credit_card</span> @d.Name</span>
                                                        <span class="amt card-amt">@MaskedYen(IsMasked,d.Amount)</span>
                                                        <span class="card-arrow msym">chevron_right</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @* ATM出金（資産移動のため統計には含めない）。財布はATM出金を持たず、
                                   財布→口座の「ATM入金」は下の振替ゾーンで扱う（#77フォローアップ）。 *@
                                @if (participatesInAtm)
                                {
                                    <div class="row atm-row">
                                        <span class="atm-label"><span class="msym">local_atm</span> ATM出金</span>
                                        <AmountInput CssClass="amt" Value="@l.AtmWithdraw" ValueChanged="v => { l.AtmWithdraw = v; RecalcWallet(Save); }" />
                                    </div>
                                }
                                @* 財布の現金支出はカテゴリ選択が加わり1行に収まらないため、スマホでは
                                   カード（カード明細のCardTabと同パターン）＋タップで編集シートを開く方式にする（#77フォローアップ）。
                                   非財布の手入力支出（カテゴリなし）は従来どおり1行編集のまま。 *@
                                @if (hasCategorizedSpending && IsMobile)
                                {
                                    @foreach (var d in manualDebits)
                                    {
                                        <button class="list-card" @onclick="() => OpenCashDebitEdit(a.Id, d.Id)">
                                            <div class="list-card-main">
                                                <span class="list-card-name">@(string.IsNullOrWhiteSpace(d.Name) ? "(項目未設定)" : d.Name)</span>
                                                <span class="list-card-amount">@MaskedYen(IsMasked,d.Amount)</span>
                                            </div>
                                            <div class="list-card-sub">
                                                <span><span class="color-dot" style="background:@(Svc.CategoryById(d.CategoryId)?.Color ?? "transparent")"></span> @(Svc.CategoryById(d.CategoryId)?.Name ?? "未分類")</span>
                                                <span class="list-card-chev msym">chevron_right</span>
                                            </div>
                                        </button>
                                    }
                                }
                                else
                                {
                                    @foreach (var d in manualDebits)
                                    {
                                        <div class="row">
                                            <input class="name" @bind="d.Name" @bind:after="Save" placeholder="項目" />
                                            @if (hasCategorizedSpending)
                                            {
                                                <select class="cat" @bind="d.CategoryId" @bind:after="Save">
                                                    <option value="">未分類</option>
                                                    @foreach (var c in Svc.CategoriesOrdered)
                                                    {
                                                        <option value="@c.Id">@c.Name</option>
                                                    }
                                                </select>
                                            }
                                            <AmountInput CssClass="amt" Value="@d.Amount" ValueChanged="v => { d.Amount = v; Svc.RequestSave(); }" />
                                            <button class="x" @onclick="() => RemoveDebit(a.Id, d.Id)">✕</button>
                                        </div>
                                    }
                                }
                                <button class="add-line" @onclick="() => { if (hasCategorizedSpending && IsMobile) AddCashDebitMobile(a.Id); else AddDebit(a.Id); }"><span class="msym">add</span>@(hasCategorizedSpending ? "現金支出を追加" : "支出を追加")</button>
                            </div>
                        }
                    </div>

                    @* 振込ゾーン（グレー・既定=閉）。送金（編集可）＋受取（他口座より・表示専用）。
                       小計＝送金(流出)−受取(流入)。正＝純流出（−¥表示）／負＝純流入（+¥表示）で、収入/支出ゾーンと符号の向きを揃える。
                       財布は通常の口座間振込ピッカーから除外し、財布⇄口座のやり取りはATM入金に一本化するため
                       財布は通常の振込とは別導線（並行導線を作らないため送金/受取ではなく「ATM入金 → 口座」）
                       だが、資産移動という性質は同じなのでゾーンの見た目（灰色）は共用する（#77フォローアップ）。 *@
                    var transferNet = outgoing.Sum(t => t.Amount) - incoming.Sum(t => t.Amount);
                    <div class="zone zone-transfer">
                        <button class="zone-head" @onclick="() => ToggleTransfer(a.Id)">
                            <span class="zone-chip zone-chip-transfer msym">swap_horiz</span>
                            <span class="zone-name zone-name-transfer">@(isWallet ? "振替（ATM入金 → 口座）" : "振込")</span>
                            <span class="zone-count">@(isWallet ? l.WalletAtmDeposits.Count : outgoing.Count + incoming.Count) 件</span>
                            <span class="zone-spacer"></span>
                            @if (isWallet)
                            {
                                @if (l.WalletAtmDeposits.Count > 0)
                                {
                                    <span class="zone-subtotal zone-subtotal-transfer">@MaskedYen(IsMasked,l.WalletAtmDeposits.Sum(w => w.Amount))</span>
                                }
                            }
                            else
                            {
                                @if (outgoing.Any() || incoming.Any())
                                {
                                    <span class="zone-subtotal zone-subtotal-transfer">@MaskedSignedYen(IsMasked,-transferNet)</span>
                                }
                            }
                            <span class="msym zone-chev">@(transferOpen ? "expand_less" : "expand_more")</span>
                        </button>
                        @if (transferOpen)
                        {
                            <div class="zone-body">
                                @if (isWallet)
                                {
                                    @if (others.Count == 0)
                                    {
                                        <div class="none">送金先の口座がありません。</div>
                                    }
                                    else
                                    {
                                        @if (l.WalletAtmDeposits.Count == 0) { <div class="none">なし</div> }
                                        @foreach (var w in l.WalletAtmDeposits)
                                        {
                                            <div class="row">
                                                <select class="name" @bind="w.AccountId" @bind:after="() => RecalcWallet(Save)">
                                                    @foreach (var o in others)
                                                    {
                                                        <option value="@o.Id">@o.Name へ</option>
                                                    }
                                                </select>
                                                <AmountInput CssClass="amt" Value="@w.Amount" ValueChanged="v => { w.Amount = v; RecalcWallet(Save); }" />
                                                <button class="x" @onclick="() => RemoveWalletAtmDeposit(a.Id, w.Id)">✕</button>
                                            </div>
                                        }
                                        <button class="add-line" @onclick="() => AddWalletAtmDeposit(a.Id, others[0].Id)"><span class="msym">add</span>ATM入金を追加</button>
                                    }
                                }
                                else
                                {
                                    @if (!outgoing.Any() && !incoming.Any()) { <div class="none">なし</div> }
                                    @foreach (var t in outgoing)
                                    {
                                        <div class="row">
                                            <select class="name" @bind="t.To" @bind:after="Save">
                                                @foreach (var o in others)
                                                {
                                                    <option value="@o.Id">@o.Name へ</option>
                                                }
                                            </select>
                                            <AmountInput CssClass="amt" Value="@t.Amount" ValueChanged="v => { t.Amount = v; Svc.RequestSave(); }" />
                                            <button class="x" @onclick="() => RemoveTransfer(t.Id)">✕</button>
                                        </div>
                                    }
                                    <button class="add-line" @onclick="() => AddTransfer(a.Id)"><span class="msym">add</span>振込を追加</button>
                                    @if (incoming.Any())
                                    {
                                        <div class="xfer-in-list">
                                            @foreach (var t in incoming)
                                            {
                                                <div class="xfer-line">
                                                    <span>@Svc.AccountName(t.From) より受取</span>
                                                    <span class="in">+@MaskedYen(IsMasked,t.Amount)</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <div class="close">
                        <div class="lab">月末残高</div>
                        <div class="amt">@MaskedYen(IsMasked,close)</div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="foot">
        月初残高は前月末から自動計算されます（起点の月のみ「開始残高」を入力）。<br />
        固定費（支出・収入とも）は表示専用です（金額の変更は固定費設定タブから）。変動費・金額未固定（<span class="msym" style="font-size:13px;vertical-align:-2px">sync</span>）はここで月ごとに金額を編集できます。カード由来はカードタブで管理し、ここでは合計を表示します。<br />
        口座間振込は送金元で設定し、振込先に「受取」として自動反映されます。
    </div>
</div>

<!-- スマホ：財布の現金支出カードのタップで開く編集シート（CardTabの明細編集シートと同パターン・#77フォローアップ） -->
<BottomSheet IsVisible="@(EditingCashDebit is not null)" Title="現金支出を編集" OnClose="CloseCashDebitEdit">
    <ChildContent>
        @if (EditingCashDebit is { } d)
        {
            <div class="sheet-field">
                <label>項目</label>
                <input @bind="d.Name" @bind:after="Save" placeholder="項目" />
            </div>
            <div class="sheet-field">
                <label>カテゴリ</label>
                <select @bind="d.CategoryId" @bind:after="Save">
                    <option value="">未分類</option>
                    @foreach (var c in Svc.CategoriesOrdered)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="sheet-field">
                <label>金額</label>
                <AmountInput CssClass="ra" Value="@d.Amount" ValueChanged="v => { d.Amount = v; Svc.RequestSave(); }" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn danger" @onclick="DeleteEditingCashDebit">削除</button>
        <button class="btn primary" style="margin-left:auto" @onclick="CloseCashDebitEdit">完了</button>
    </FooterContent>
</BottomSheet>

@code {
    private MonthData Mo = new();

    // スマホ=折りたたみ / PC=展開を既定にするため IsMobile を受ける。
    [CascadingParameter(Name = "IsMobile")] public bool IsMobile { get; set; }
    [CascadingParameter(Name = "IsMasked")] public bool IsMasked { get; set; }

    // ダイアログ（現金支出の編集シート）表示中は背面スクロールをロック。
    private bool AnyDialogOpen => EditingCashDebit is not null;
    private bool _scrollLocked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (AnyDialogOpen != _scrollLocked)
        {
            _scrollLocked = AnyDialogOpen;
            await JS.InvokeVoidAsync("moneyboardViewport.setBodyScrollLock", _scrollLocked);
            Overlay.SetOpen(nameof(MonthlyTab), AnyDialogOpen);
        }
    }

    public void Dispose()
    {
        if (_scrollLocked) _ = JS.InvokeVoidAsync("moneyboardViewport.setBodyScrollLock", false);
        Overlay.SetOpen(nameof(MonthlyTab), false);
    }

    // 開閉状態（口座IDを保持）。_toggled＝口座カードを既定から反転した口座。
    // カード/固定費ブロックは既定折りたたみで、_cardOpen/_fixedOpen は展開中の口座。
    private readonly HashSet<string> _toggled = new();
    private readonly HashSet<string> _cardOpen = new();
    private readonly HashSet<string> _fixedOpen = new();
    private readonly HashSet<string> _fixedIncomeOpen = new();

    // 収入/支出/振込ゾーンの開閉（口座IDを保持）。既定はすべて閉、_xxxToggled は展開中の口座。
    private readonly HashSet<string> _incomeToggled = new();
    private readonly HashSet<string> _expenseToggled = new();
    private readonly HashSet<string> _transferToggled = new();
    // 財布のATM入金（自動受取）内訳の折りたたみ（口座IDを保持・既定は閉・#77フォローアップ）。
    private readonly HashSet<string> _walletAtmInOpen = new();
    // 「＋ボーナスを追加」で手動表示にした口座＋月（#134）。永続化しない表示状態のため、
    // 金額0のまま画面を離れると次回は BonusSchedule の通常判定に戻る（実額を入れれば①②で表示継続）。
    private readonly HashSet<string> _manualBonusShown = new();

    // 現在月以降は IsDeleted の口座を非表示、過去月はキープ。
    // 「過去月」判定は財務サイクル起点（CurrentCycleStartYm）基準（#77フォローアップで判明した既存バグを修正：
    // 暦月の NowYm() と比較していたため、給料日サイクルの関係で暦月とサイクル起点月がずれる期間
    // （例：当月16日始まりのサイクルで、暦の月初〜15日の間）は当月サイクルなのに「過去月」判定され、
    // ソフト削除済み口座（財布OFF含む）が現在月から消えずに残ってしまっていた）。
    private List<Account> ActiveAccountsForMonth
    {
        get
        {
            bool isPast = !LedgerService.IsCurrentOrFutureCycle(Svc.CurrentMonth);
            if (isPast)
                return Svc.State.Accounts
                    .Where(a => Mo.Ledgers.ContainsKey(a.Id) && (!a.IsDeleted || LedgerEngine.HasActivity(Mo, a.Id)))
                    .OrderByDescending(a => a.Type == AccountType.Wallet)
                    .ThenBy(a => a.SortOrder)
                    .ToList();
            return Svc.ActiveAccounts;
        }
    }

    // 変動費の編集値保護（AmountOverridden）は当月に限る（翌月以降は常にマスタへ一律追随・#87）。
    // 未来月で編集した値がそのまま「当月になった時点で保護対象」として残留しないよう、
    // 表示中の月が実際に当月サイクルの場合のみ true をセットする。
    private bool IsCurrentCycleMonth => Svc.CurrentMonth == LedgerService.CurrentCycleStartYm();

    private decimal Total => ActiveAccountsForMonth.Sum(a => Svc.CloseOf(Svc.CurrentMonth, a.Id));
    private int Short => ActiveAccountsForMonth.Count(a => Svc.CloseOf(Svc.CurrentMonth, a.Id) < 0);
    // 当月の支出＝全口座の支出(Debits)合計。ATM/送金は資産移動のため除外（統計と同じ流儀）。
    private decimal MonthSpend => ActiveAccountsForMonth.Sum(a => Mo.Ledgers[a.Id].Debits.Sum(d => d.Amount));

    protected override void OnInitialized() => Mo = Svc.EnsureMonth(Svc.CurrentMonth);


    private void Save() => _ = Svc.SaveAsync();

    private void ToggleAccount(string aid) { if (!_toggled.Add(aid)) _toggled.Remove(aid); }
    private void ToggleCardBlock(string aid) { if (!_cardOpen.Add(aid)) _cardOpen.Remove(aid); }
    private void ToggleFixed(string aid) { if (!_fixedOpen.Add(aid)) _fixedOpen.Remove(aid); }
    private void ToggleFixedIncome(string aid) { if (!_fixedIncomeOpen.Add(aid)) _fixedIncomeOpen.Remove(aid); }
    private void ToggleIncome(string aid) { if (!_incomeToggled.Add(aid)) _incomeToggled.Remove(aid); }
    private void ToggleExpense(string aid) { if (!_expenseToggled.Add(aid)) _expenseToggled.Remove(aid); }
    private void ToggleTransfer(string aid) { if (!_transferToggled.Add(aid)) _transferToggled.Remove(aid); }
    private void ToggleWalletAtmIn(string aid) { if (!_walletAtmInOpen.Add(aid)) _walletAtmInOpen.Remove(aid); }

    // 起点月（State.Months 最古）より過去へは戻れない
    private bool IsPrevDisabled =>
        !Svc.State.Months.Keys.Any() ||
        string.Compare(Svc.CurrentMonth, Svc.State.Months.Keys.Min()) <= 0;


    // カード明細はカードタブで編集する。月次の月をカードタブへ引き継いでから切替。
    [Parameter] public EventCallback<string> RequestTab { get; set; }
    // 押下したカードの月へ合わせ、対象カードを指定してカードタブへ（先で展開＆スクロール）。
    private Task GoToCard(string? cardId)
    {
        Svc.CardMonth = Svc.CurrentMonth;
        Svc.ScrollToCardId = cardId;
        return RequestTab.InvokeAsync("card");
    }
    private void Prev() { Svc.CurrentMonth = LedgerService.PrevYm(Svc.CurrentMonth); Mo = Svc.EnsureMonth(Svc.CurrentMonth); }
    private void Next() { Svc.CurrentMonth = LedgerService.NextYm(Svc.CurrentMonth); Mo = Svc.EnsureMonth(Svc.CurrentMonth); }


    private void AddDebit(string aid) { Mo.Ledgers[aid].Debits.Add(new Debit()); Save(); }
    private void RemoveDebit(string aid, string did) { Mo.Ledgers[aid].Debits.RemoveAll(d => d.Id == did); Save(); }

    // ── スマホ：財布の現金支出カードのタップで開く編集シート（CardTab の明細編集と同パターン・#77フォローアップ）──
    private (string AccountId, string DebitId)? _editingCashDebit;
    private bool _isNewCashDebit;   // ＋追加で開いた新規現金支出か（未入力のまま閉じたら破棄）
    private Debit? EditingCashDebit =>
        _editingCashDebit is { } ed && Mo.Ledgers.TryGetValue(ed.AccountId, out var l)
            ? l.Debits.FirstOrDefault(d => d.Id == ed.DebitId)
            : null;
    private void OpenCashDebitEdit(string aid, string did) { _editingCashDebit = (aid, did); _isNewCashDebit = false; }

    // ＋追加：スマホは作成後すぐ編集シートを開く（先にカードを表示してから項目を入力する導線・#77フォローアップ）。
    private void AddCashDebitMobile(string aid)
    {
        var d = new Debit();
        Mo.Ledgers[aid].Debits.Add(d);
        Save();
        _editingCashDebit = (aid, d.Id);
        _isNewCashDebit = true;
    }

    private void CloseCashDebitEdit()
    {
        // 未入力（項目名なし・金額0）のまま閉じた新規現金支出は追加しない（破棄）。
        if (_isNewCashDebit && _editingCashDebit is { } ed && EditingCashDebit is { } d
            && string.IsNullOrWhiteSpace(d.Name) && d.Amount == 0)
        {
            _editingCashDebit = null;
            _isNewCashDebit = false;
            RemoveDebit(ed.AccountId, ed.DebitId);
            return;
        }
        _editingCashDebit = null;
        _isNewCashDebit = false;
    }

    private void DeleteEditingCashDebit()
    {
        if (_editingCashDebit is { } ed) RemoveDebit(ed.AccountId, ed.DebitId);
        _editingCashDebit = null;
        _isNewCashDebit = false;
    }

    private void AddBonusInput(string aid) => _manualBonusShown.Add(aid + "|" + Svc.CurrentMonth);

    private void AddIncome(string aid) { Mo.Ledgers[aid].Incomes.Add(new IncomeItem()); Save(); }
    private void RemoveIncome(string aid, string iid) { Mo.Ledgers[aid].Incomes.RemoveAll(i => i.Id == iid); Save(); }

    private void AddTransfer(string aid)
    {
        // 財布は通常の振込ピッカーの対象外（#77）。
        var others = ActiveAccountsForMonth.Where(x => x.Id != aid && x.Type.ParticipatesInAtm()).ToList();
        if (others.Count == 0) return;
        Mo.Transfers.Add(new Transfer { From = aid, To = others[0].Id });
        Save();
    }
    private void RemoveTransfer(string tid) { Mo.Transfers.RemoveAll(t => t.Id == tid); Save(); }

    // ── 財布（現金）── ATM入金（財布→口座・要口座選択）の編集（#77）────
    // 口座のATM出金／財布のATM入金明細を編集した際は、同じ月内で対称の実体化値を即時に再計算する。
    private void RecalcWallet(Action after) { Svc.RecalcWallet(Svc.CurrentMonth); after(); }

    private void AddWalletAtmDeposit(string walletId, string defaultAccountId)
    {
        Mo.Ledgers[walletId].WalletAtmDeposits.Add(new WalletAtmDeposit { AccountId = defaultAccountId });
        RecalcWallet(Save);
    }
    private void RemoveWalletAtmDeposit(string walletId, string id)
    {
        Mo.Ledgers[walletId].WalletAtmDeposits.RemoveAll(w => w.Id == id);
        RecalcWallet(Save);
    }
}
